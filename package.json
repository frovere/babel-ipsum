{
  "name": "babel-ipsum-development",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test:extraction": "python3 -m unittest discover -s tests -p '*_test.py'",
    "corpus:extract": "python3 scripts/extract-corpus.py && node scripts/prepare-sub-terra.mjs",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "corpus:fetch:western": "python3 scripts/import-western.py --refresh",
    "corpus:fetch:multilingual": "python3 scripts/import-multilingual.py --fetch",
    "corpus:prepare:sub-terra": "node scripts/prepare-sub-terra.mjs",
    "corpus:extract:western": "python3 scripts/import-western.py --offline",
    "corpus:extract:multilingual": "python3 scripts/import-multilingual.py",
    "corpus:audit": "node scripts/audit-corpus.mjs && node scripts/prepare-sub-terra.mjs --check && python3 scripts/import-western.py --offline --check && python3 scripts/import-multilingual.py --audit",
    "artwork:build": "node scripts/build-artwork.mjs",
    "build": "npm --prefix extension run build",
    "dev": "npm --prefix extension run dev",
    "fix-lint": "npm --prefix extension run fix-lint",
    "lint": "npm --prefix extension run lint",
    "typecheck": "npm --prefix extension run typecheck",
    "publish": "npm --prefix extension run publish",
    "format": "prettier --write . && npm --prefix extension run format",
    "format:check": "prettier --check . && npm --prefix extension run format:check",
    "test": "npm --prefix extension test && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.5"
  }
}
