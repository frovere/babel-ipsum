{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "vibed-ipsum",
  "title": "Vibed Ipsum",
  "description": "Generate Spanish placeholder text from Baldomero Lillo’s Sub terra, entirely offline",
  "icon": "extension-icon.png",
  "author": "felrov",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "generate-paragraphs",
      "title": "Generate Sub Terra Paragraphs",
      "subtitle": "Vibed Ipsum",
      "description": "Preview, copy, or paste random paragraphs from Sub terra",
      "mode": "view"
    },
    {
      "name": "generate-sentences",
      "title": "Generate Sub Terra Sentences",
      "subtitle": "Vibed Ipsum",
      "description": "Preview, copy, or paste random sentences from Sub terra",
      "mode": "view"
    }
  ],
  "tools": [],
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.5.0",
    "prettier": "^3.8.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && ray build --output dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:extraction": "python3 -m unittest discover -s tests -p '*_test.py'",
    "corpus:extract": "python3 scripts/extract-corpus.py",
    "corpus:build": "python3 scripts/extract-corpus.py && node scripts/build-corpus.mjs",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "preferences": [
    {
      "name": "defaultParagraphCount",
      "title": "Default Paragraph Count",
      "description": "Number of paragraphs to generate when the count field is empty.",
      "type": "dropdown",
      "required": false,
      "default": "3",
      "data": [
        {
          "title": "1",
          "value": "1"
        },
        {
          "title": "2",
          "value": "2"
        },
        {
          "title": "3",
          "value": "3"
        },
        {
          "title": "4",
          "value": "4"
        },
        {
          "title": "5",
          "value": "5"
        },
        {
          "title": "6",
          "value": "6"
        },
        {
          "title": "7",
          "value": "7"
        },
        {
          "title": "8",
          "value": "8"
        },
        {
          "title": "9",
          "value": "9"
        },
        {
          "title": "10",
          "value": "10"
        }
      ]
    },
    {
      "name": "defaultSentenceCount",
      "title": "Default Sentence Count",
      "description": "Number of sentences to generate when the count field is empty.",
      "type": "dropdown",
      "required": false,
      "default": "3",
      "data": [
        {
          "title": "1",
          "value": "1"
        },
        {
          "title": "2",
          "value": "2"
        },
        {
          "title": "3",
